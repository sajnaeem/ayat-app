{
  "expo": {
    "name": "Munib",
    "slug": "munib",
    "owner": "sajdood",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.munib",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "PU56752R6X"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6E52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.munib"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F1F3EF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#121A16"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Munib uses the microphone only when you choose to practise reciting, so you can hear yourself and check your words."
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#1F6E52",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Munib lets you attach a screenshot when you send feedback.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Munib uses your location on your phone only, to point you towards the Qibla. It isn't sent anywhere.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "munib",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ba03556b-e7ef-461b-867b-db976fca47ac"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ba03556b-e7ef-461b-867b-db976fca47ac"
    }
  }
}
