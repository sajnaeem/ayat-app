{
  "rewrites": [
    {
      "source": "/k/:code([A-Za-z0-9]{4,8})",
      "destination": "/api/khatm?code=:code"
    },
    {
      "source": "/:s(\\d{1,3})/:a(\\d{1,3}(?:-\\d{1,3})?)",
      "destination": "/api/ayah?s=:s&a=:a"
    },
    {
      "source": "/:s(\\d{1,3})",
      "destination": "/api/ayah?s=:s&a=1"
    }
  ]
}
